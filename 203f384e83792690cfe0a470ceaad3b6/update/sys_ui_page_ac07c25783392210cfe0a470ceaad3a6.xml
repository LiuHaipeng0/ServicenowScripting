<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>catalog</category>
        <client_script><![CDATA[function getFromServer() {
    var ga = new GlideAjax('GetDataForPage2');
    ga.addParam('sysparm_name', 'getData');
    ga.getXML(displayData);
}

function displayData(response) {
    var answer = response.responseXML.documentElement.getAttribute("answer");
    var result = JSON.parse(answer);
    
    document.getElementById('valueDisplay').textContent = result.count;
    
    var now = new Date();
    document.getElementById('timeDisplay').textContent = now.toLocaleTimeString();
}

function showConfirmDialog() {
    if (confirm('Please Click OK To Display Value?')) {
        getFromServer();
    } else {
		// Do nothing
    }
}]]></client_script>
        <description/>
        <direct>false</direct>
        <endpoint>x_1755520_scriptin_ChangeValueByAjax2.do</endpoint>
        <html><![CDATA[<?xml version="1.0" encoding="utf-8"?>
<j:jelly trim="false" xmlns:j="jelly:core" xmlns:g="glide" xmlns:j2="null" xmlns:g2="null">
